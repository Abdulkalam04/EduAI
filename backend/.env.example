# Local OpenAI-compatible OmniRoute gateway URL.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# API key created in the OmniRoute dashboard (leave empty only if your gateway permits it).
OMNIROUTE_API_KEY=
# Model used for class-adaptive tutoring and general answers.
MODEL_TEACHER=mistral/mistral-medium-3-5
# Comma-separated fallbacks. Paid and personal-login providers are always refused.
MODEL_TEACHER_FALLBACKS=mistral/mistral-small-latest,groq/openai/gpt-oss-120b,gemini/gemini-3-flash-preview
# Primary model for practice-paper generation.
MODEL_PRACTICE=mistral/mistral-medium-3-5
MODEL_PRACTICE_FALLBACKS=mistral/mistral-small-latest,gemini/gemini-3-flash-preview,groq/openai/gpt-oss-120b
# Model used for solving, grading, viva, code help, and Mermaid generation.
# Prefer Mistral Large for reasoning.
MODEL_REASONING=mistral/mistral-large-latest
MODEL_REASONING_FALLBACKS=mistral/mistral-medium-3-5,groq/openai/gpt-oss-120b,gemini/gemini-3-flash-preview
# Model used for image understanding and long documents.
MODEL_MULTIMODAL=gemini/gemini-3-flash-preview
MODEL_MULTIMODAL_FALLBACKS=mistral/mistral-medium-3-5,gemini/gemini-3.1-flash-lite
# Model used for inexpensive structured JSON generation.
MODEL_JSON=mistral/mistral-small-latest
MODEL_JSON_FALLBACKS=mistral/mistral-medium-3-5,gemini/gemini-3-flash-preview,groq/openai/gpt-oss-120b
# Model catalogue and paid model routing policy
ALLOW_PAID_MODEL_SELECTION=false
ALLOW_PAID_FALLBACK=false
# Only providers listed here may be used. Their models are free when pricing is
# unknown/null or zero; any explicitly positive price is always refused.
FREE_ONLY=true
FREE_PROVIDERS=gemini,groq,mistral
MODEL_META_OVERRIDES=
# Ordered comma-separated model IDs shown in the Ask model picker (empty = Auto only).
CHAT_MODEL_ALLOWLIST=mistral/mistral-medium-3-5,mistral/mistral-large-latest,mistral/mistral-small-latest,groq/openai/gpt-oss-120b,gemini/gemini-3-flash-preview
# Maximum picker entries including Auto; values above 6 are capped at 6.
CHAT_PICKER_MAX=6
# Chat routing, hedging and timeouts
CHAT_HEDGE_AFTER_MS=0
CHAT_HEDGE_MAX_PARALLEL=1
CHAT_FIRST_TOKEN_TIMEOUT=25
JSON_FIRST_TOKEN_TIMEOUT=20.0
REASONING_FIRST_TOKEN_TIMEOUT=30.0
CHAT_CONNECT_TIMEOUT_SECONDS=3.0
REASONING_MAX_TOKENS_CAP=8192
# Per-provider rolling request/token budgets; set 0 for no local limit.
PROVIDER_RPM_GEMINI=10
PROVIDER_RPM_GROQ=20
PROVIDER_TPM_GROQ=5000
PROVIDER_RPM_MISTRAL=50
PROVIDER_TPM_MISTRAL=400000
# Reasoning policy by task (empty values use the task's built-in default).
REASONING_EFFORT_PPT=low
REASONING_EFFORT_MCQ=low
REASONING_EFFORT_FLASHCARD=low
REASONING_EFFORT_NOTES=low
REASONING_EFFORT_SPLIT=low
REASONING_EFFORT_VIVA_QUESTIONS=low
REASONING_EFFORT_MERMAID=low
REASONING_EFFORT_EVALUATION_FEEDBACK=low
REASONING_EFFORT_PRACTICE=low
REASONING_EFFORT_SOLVE=low
REASONING_EFFORT_GRADING=high
REASONING_EFFORT_CODE_DEBUG=high
# Keep chat reasoning low so thinking models reserve more of the output budget for answers.
REASONING_EFFORT_CHAT=low
# Number of past messages included in tutor context.
CHAT_HISTORY_LIMIT=8
# Maximum tokens by answer style.
CHAT_MAX_TOKENS_SIMPLE=2000
CHAT_MAX_TOKENS_EXAM=2400
CHAT_MAX_TOKENS_DETAILED=3000
# Keep this within the context limits of every configured multimodal fallback.
LONG_CONTEXT_MAX_TOKENS=120000
# Maximum simultaneous requests; tune against provider account quota pages.
MAX_CONCURRENT_LLM=2
# Optional document embeddings; keep disabled unless explicitly configured.
EMBEDDINGS=none
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:8082,http://localhost,https://localhost
# Optional regex for localhost and private LAN frontend origins (including phone testing).
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(:\d+)?$
# SQLite database location (optional override).
DATABASE_URL=sqlite:///./eduai.db
# Static directory mounted at /uploads (optional override).
UPLOADS_DIR=uploads
# Trust first X-Forwarded-For IP when behind a reverse proxy or tunnel.
TRUST_PROXY_HEADERS=false
# Optional access token required for /api/* requests (empty = disabled).
APP_ACCESS_TOKEN=
# Optional Supabase JWT secret for validating Auth bearer tokens.
SUPABASE_JWT_SECRET=
SUPABASE_URL=
