# Local OpenAI-compatible OmniRoute gateway URL.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# API key created in the OmniRoute dashboard (leave empty only if your gateway permits it).
OMNIROUTE_API_KEY=
# Model used for class-adaptive tutoring and general answers.
MODEL_TEACHER=
# Optional faster model for practice generation (defaults to MODEL_TEACHER).
MODEL_PRACTICE=
# Model used for solving, grading, viva, code help, and Mermaid generation.
MODEL_REASONING=
# Model used for image understanding and long documents.
MODEL_MULTIMODAL=
# Model used for inexpensive structured JSON generation.
MODEL_JSON=
# Reasoning policy by task (empty values use the task's built-in default).
REASONING_EFFORT_PPT=low
REASONING_EFFORT_MCQ=low
REASONING_EFFORT_FLASHCARD=low
REASONING_EFFORT_NOTES=low
REASONING_EFFORT_SPLIT=low
REASONING_EFFORT_VIVA_QUESTIONS=low
REASONING_EFFORT_MERMAID=low
REASONING_EFFORT_EVALUATION_FEEDBACK=low
REASONING_EFFORT_PRACTICE=low
REASONING_EFFORT_SOLVE=high
REASONING_EFFORT_GRADING=high
REASONING_EFFORT_CODE_DEBUG=high
# Conservative context ceiling to avoid free-tier token-per-minute limits.
LONG_CONTEXT_MAX_TOKENS=120000
# Maximum simultaneous requests to OmniRoute.
MAX_CONCURRENT_LLM=4
# Optional document embeddings; keep disabled unless explicitly configured.
EMBEDDINGS=none
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
# SQLite database location (optional override).
DATABASE_URL=sqlite:///./eduai.db
# Static directory mounted at /uploads (optional override).
UPLOADS_DIR=uploads
